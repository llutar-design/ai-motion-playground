{
  "name": "ai-motion-playground",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI 모션 플레이그라운드 - 웹캠 1대로 즐기는 모션 인식 게임 플랫폼",
  "scripts": {
    "setup:assets": "node scripts/setup-assets.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
